{
  "info": {
    "_postman_id": "f52f7674-5627-44d8-9b8f-f7dd16cb9baf",
    "name": "CS361 V2 Lecturer Education API",
    "description": "GET list/detail, POST, PATCH and DELETE lecturer education endpoints. Configure baseUrl, lecturerId and educationId after connecting the HTTP routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://your-api-id.execute-api.ap-southeast-1.amazonaws.com",
      "type": "string"
    },
    {
      "key": "lecturerId",
      "value": "fac_prapaporn-rattanatamrong",
      "type": "string"
    },
    {
      "key": "educationId",
      "value": "edu_replace_with_existing_id",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Delete education",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v2/lecturers/{{lecturerId}}/educations/{{educationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 204 No Content', function () {",
              "  pm.response.to.have.status(204);",
              "});",
              "pm.test('has no response body', function () {",
              "  pm.expect(pm.response.text()).to.eql('');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Patch education",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institution\": \"Updated University\",\n  \"graduation_year\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v2/lecturers/{{lecturerId}}/educations/{{educationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('returns the updated education', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.id).to.eql(pm.collectionVariables.get('educationId'));",
              "  pm.expect(body.data.faculty_id).to.eql(pm.collectionVariables.get('lecturerId'));",
              "  pm.expect(body.data.institution).to.eql('Updated University');",
              "  pm.expect(body.data.graduation_year).to.eql(null);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get education detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v2/lecturers/{{lecturerId}}/educations/{{educationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('returns the requested education owned by the lecturer', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an('object');",
              "  pm.expect(body.data.id).to.eql(pm.collectionVariables.get('educationId'));",
              "  pm.expect(body.data.faculty_id).to.eql(pm.collectionVariables.get('lecturerId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List lecturer educations",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v2/lecturers/{{lecturerId}}/educations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('returns education items and count metadata', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.items).to.be.an('array');",
              "  pm.expect(body.meta.count).to.eql(body.items.length);",
              "});",
              "pm.test('each item belongs to the requested lecturer', function () {",
              "  const lecturerId = pm.collectionVariables.get('lecturerId');",
              "  pm.response.json().items.forEach(function (item) {",
              "    pm.expect(item.faculty_id).to.eql(lecturerId);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create education",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"degree\": \"Postman test degree\",\n  \"field_of_study\": \"Computer Science\",\n  \"institution\": \"Postman Test University\",\n  \"country\": \"Thailand\",\n  \"graduation_year\": 2560\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v2/lecturers/{{lecturerId}}/educations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('returns the created education', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an('object');",
              "  pm.expect(body.data.id).to.be.a('string').and.not.empty;",
              "  pm.expect(body.data.faculty_id).to.eql(pm.collectionVariables.get('lecturerId'));",
              "});",
              "pm.test('provides the created resource Location', function () {",
              "  pm.expect(pm.response.headers.get('Location')).to.include('/educations/');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"graduation_year\": \"not-an-integer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v2/lecturers/{{lecturerId}}/educations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 400 VALIDATION_ERROR', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
