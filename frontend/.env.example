# Copy to .env.local and fill in the deployed API Gateway stage URL.
# Example: https://<api-id>.execute-api.<region>.amazonaws.com/prod
NEXT_PUBLIC_API_BASE_URL=

# FastAPI backend (backend/, routes under /api/v2) used by the /manage pages.
# Server-only (no NEXT_PUBLIC_ prefix): the browser never sees it.
BACKEND_API_BASE_URL=http://localhost:8000
