// V2 Faculty Output Repository
// Paste this DBML into https://dbdiagram.io/d

Project "V2 Faculty Output Repository" {
  database_type: "PostgreSQL"
  Note: '''
  Managed multi-year faculty output repository.
  Aurora PostgreSQL target.
  work_item is the central entity.
  faculty_work_item supports many-to-many faculty contribution.
  '''
}

Table faculty {
  id text [pk]
  public_slug text [not null, unique, note: "Preserve V1 public slug"]
  name_th text
  name_en text
  academic_position text
  department text
  office_public text
  phone_public text
  email_public text
  profile_image_url text
  profile_image_alt text
  visibility text [not null, default: "PUBLIC", note: "PUBLIC, INTERNAL, RESTRICTED"]
  status text [not null, default: "ACTIVE", note: "ACTIVE, DELETED"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: "Faculty master data. public_slug must preserve V1 public URL compatibility."
}

Table faculty_education {
  id text [pk]
  faculty_id text [not null]
  degree text
  field_of_study text
  institution text
  country text
  graduation_year integer
  display_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table faculty_interest {
  id text [pk]
  faculty_id text [not null]
  interest_type text [not null, note: "RESEARCH_INTEREST, EXPERTISE, KEYWORD"]
  value text [not null]
  visibility text [not null, default: "PUBLIC", note: "PUBLIC, INTERNAL, RESTRICTED"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (faculty_id, interest_type, value) [unique]
  }
}

Table app_user {
  id text [pk]
  cognito_sub text [not null, unique, note: "Cognito subject identifier"]
  email text [note: "SQL enforces case-insensitive uniqueness only when email is present"]
  display_name text
  identity_provider text [not null, default: "COGNITO", note: "COGNITO, SYSTEM"]
  status text [not null, default: "ACTIVE", note: "ACTIVE, SUSPENDED, DELETED"]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    email [unique]
    status
  }

  Note: "Application identity mapping for Cognito users. Passwords and sessions are not stored in this database."
}

Table app_role {
  code text [pk]
  label text [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: "Baseline roles: ADMIN, SYSTEM. This is not a full dynamic RBAC permission matrix."
}

Table app_user_role {
  id text [pk]
  user_id text [not null]
  role_code text [not null]
  assigned_by_user_id text
  assigned_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  revoke_reason text

  Indexes {
    user_id
    role_code
    (user_id, role_code) [unique]
  }

  Note: "SQL enforces one active role per user and role with a partial unique index where revoked_at is null."
}

Table auth_login_event {
  id text [pk]
  user_id text
  cognito_sub text
  email text
  login_status text [not null, note: "SUCCESS, FAILED"]
  failure_reason text
  ip_address inet
  user_agent text
  request_id text
  occurred_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
    occurred_at
    login_status
  }

  Note: "Login audit event from Cognito-authenticated admin flow."
}

Table academic_period {
  id text [pk]
  academic_year integer [not null]
  semester text [not null, note: "1, 2, 3, SUMMER, OTHER"]
  label text [not null, note: "Example: 2/2567"]
  start_date date
  end_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (academic_year, semester) [unique]
  }
}

Table evaluation_period {
  id text [pk]
  code text [not null, unique]
  label text [not null]
  start_date date [not null]
  end_date date [not null]
  academic_period_id text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: "Evaluation period is separate from academic period because academic year may not match calendar year."
}

Table work_category {
  code text [pk]
  label_th text [not null]
  label_en text [not null]
  description text
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table work_type {
  code text [pk]
  category_code text [not null]
  label_th text [not null]
  label_en text [not null]
  description text
  default_visibility text [not null, default: "INTERNAL", note: "PUBLIC, INTERNAL, RESTRICTED"]
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (category_code, code) [unique]
  }
}

Table import_batch {
  id text [pk]
  source_system text [not null]
  source_name text [not null]
  source_version text
  source_type text [not null]
  source_s3_key text
  source_hash text [not null]
  status text [not null, default: "PENDING", note: "PENDING, RUNNING, SUCCEEDED, FAILED, WARNING"]
  record_count integer [not null, default: 0]
  valid_count integer [not null, default: 0]
  warning_count integer [not null, default: 0]
  error_count integer [not null, default: 0]
  started_at timestamptz
  completed_at timestamptz
  created_by text
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (source_system, source_name, source_hash) [unique]
  }
}

Table source_record {
  id text [pk]
  import_batch_id text [not null]
  source_system text [not null]
  source_record_key text [not null]
  source_section_code text
  source_hash text [not null]
  row_number integer
  raw_record jsonb [not null, default: "{}"]
  target_entity_type text
  target_entity_id text
  status text [not null, default: "PENDING", note: "PENDING, IMPORTED, SKIPPED, WARNING, ERROR"]
  error_message text
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (source_system, source_record_key, source_hash) [unique]
    (target_entity_type, target_entity_id)
  }

  Note: "source_system + source_record_key + source_hash is the import idempotency key."
}

Table work_item {
  id text [pk]
  category_code text [not null]
  work_type_code text [not null]
  title text [not null]
  description text
  start_date date
  end_date date
  visibility text [not null, default: "INTERNAL", note: "PUBLIC, INTERNAL, RESTRICTED"]
  status text [not null, default: "ACTIVE", note: "ACTIVE, DELETED"]
  source_score numeric
  source_weight numeric
  source_section_code text
  import_batch_id text
  source_record_id text
  created_by text
  updated_by text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    category_code
    work_type_code
    visibility
    status
    (status, visibility)
    (start_date, end_date)
    source_record_id
    title
  }

  Note: '''
  Central entity for all faculty output/workload records.
  source_score/source_weight are source-reported values, not a V2 scoring engine.
  '''
}

Table faculty_work_item {
  id text [pk]
  faculty_id text [not null]
  work_item_id text [not null]
  academic_period_id text
  evaluation_period_id text
  role text
  contribution_order integer
  contribution_percent numeric
  contribution_note text
  quantity numeric
  credits numeric
  hours numeric
  source_section_code text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (faculty_id, work_item_id, role) [unique]
    faculty_id
    work_item_id
    academic_period_id
    evaluation_period_id
    (faculty_id, academic_period_id)
  }

  Note: "Many-to-many contribution table between faculty and work_item."
}

Table teaching_detail {
  work_item_id text [pk]
  course_code text
  course_title text
  degree_level text
  teaching_mode text
  section_count integer
  student_count integer
  credits numeric
  lecture_hours numeric
  lab_hours numeric
  workload_hours numeric
  reference_label text
}

Table publication_detail {
  work_item_id text [pk]
  publication_title text [not null]
  venue text
  publisher text
  publication_year integer
  publication_date date
  doi text
  isbn text
  issn text
  quartile text
  indexing_database text
  publication_kind text
  external_url text

  Indexes {
    publication_year
    publication_title
    doi [unique]
  }

  Note: "DOI should be unique when present. In SQL migration this is implemented as a partial lower(doi) unique index."
}

Table research_project_detail {
  work_item_id text [pk]
  project_title text
  funding_source text
  funding_type text
  budget_amount numeric
  currency text [default: "THB"]
  project_status text
  contract_number text
  principal_investigator text
  project_start_date date
  project_end_date date
}

Table supervision_detail {
  work_item_id text [pk]
  supervision_type text
  supervision_role text
  degree_level text
  program_name text
  course_code text
  student_count integer
  credits numeric
  student_identifier_policy text [not null, default: "REDACTED", note: "REDACTED, INTERNAL_ONLY, NOT_STORED"]
}

Table service_detail {
  work_item_id text [pk]
  service_scope text
  organization_name text
  service_role text
  committee_name text
  order_reference text
  service_date date
  service_end_date date
}

Table administration_detail {
  work_item_id text [pk]
  position_title text
  organization_unit text
  appointment_type text
  appointed_from date
  appointed_to date
  appointment_reference text
}

Table evidence_reference {
  id text [pk]
  work_item_id text [not null]
  reference_type text [not null, note: "URL, S3_OBJECT, DOCUMENT_ID, TEXT_NOTE, OTHER"]
  label text [not null]
  external_url text
  s3_key text [note: "Private internal reference. Do not expose directly through public API."]
  mime_type text
  checksum_sha256 text
  visibility text [not null, default: "INTERNAL", note: "PUBLIC, INTERNAL, RESTRICTED"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    work_item_id
    visibility
  }
}

Table audit_event {
  id text [pk]
  actor_user_id text
  actor_subject text
  action text [not null]
  entity_type text [not null]
  entity_id text [not null]
  before_json jsonb
  after_json jsonb
  request_id text
  occurred_at timestamptz [not null, default: `now()`]

  Indexes {
    (entity_type, entity_id)
    occurred_at
  }

  Note: "Audit data is internal only and must not be exposed through public API."
}

Ref: faculty_education.faculty_id > faculty.id [delete: cascade]
Ref: faculty_interest.faculty_id > faculty.id [delete: cascade]

Ref: app_user_role.user_id > app_user.id [delete: cascade]
Ref: app_user_role.role_code > app_role.code
Ref: app_user_role.assigned_by_user_id > app_user.id [delete: set null]
Ref: auth_login_event.user_id > app_user.id [delete: set null]

Ref: evaluation_period.academic_period_id > academic_period.id [delete: set null]

Ref: work_type.category_code > work_category.code

Ref: source_record.import_batch_id > import_batch.id [delete: cascade]

Ref: work_item.category_code > work_category.code
Ref: work_item.work_type_code > work_type.code
Ref: work_item.import_batch_id > import_batch.id [delete: set null]
Ref: work_item.source_record_id > source_record.id [delete: set null]

Ref: faculty_work_item.faculty_id > faculty.id [delete: cascade]
Ref: faculty_work_item.work_item_id > work_item.id [delete: cascade]
Ref: faculty_work_item.academic_period_id > academic_period.id [delete: set null]
Ref: faculty_work_item.evaluation_period_id > evaluation_period.id [delete: set null]

Ref: teaching_detail.work_item_id - work_item.id [delete: cascade]
Ref: publication_detail.work_item_id - work_item.id [delete: cascade]
Ref: research_project_detail.work_item_id - work_item.id [delete: cascade]
Ref: supervision_detail.work_item_id - work_item.id [delete: cascade]
Ref: service_detail.work_item_id - work_item.id [delete: cascade]
Ref: administration_detail.work_item_id - work_item.id [delete: cascade]

Ref: evidence_reference.work_item_id > work_item.id [delete: cascade]
Ref: audit_event.actor_user_id > app_user.id [delete: set null]
