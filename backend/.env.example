# -----------------------------------------------------------------------------
# CS361 Backend (FastAPI)
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real passwords; the real ones live in
# AWS Secrets Manager (see docs/v2/deployment-env.md and docs/v2/security.md).
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_NAME=CS361 Faculty Output API
# local | dev | demo | prod   (/docs and /openapi.json are disabled in prod)
ENVIRONMENT=local
LOG_LEVEL=INFO
# JSON list of allowed browser origins (Next.js frontend runs on :3000)
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Database (PostgreSQL / Aurora PostgreSQL) -------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cs361v2
DB_USER=postgres
# Must be changed outside ENVIRONMENT=local, or the app refuses to start.
DB_PASSWORD=change-me
# disable | prefer | require | verify-full   (use `require` or stricter for Aurora)
DB_SSLMODE=prefer
# true = log every SQL statement (local debugging only)
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# On AWS: Secrets Manager ARN of the DB credential. When set, DB_USER / DB_PASSWORD (and
# DB_HOST / DB_PORT if the secret has them) come from the secret, re-read every
# DB_SECRET_CACHE_SECONDS so a rotated password keeps working.
DB_SECRET_ARN=
DB_SECRET_CACHE_SECONDS=300

# --- Object storage (S3) for profile images and CVs --------------------------
AWS_REGION=ap-southeast-1
DATA_BUCKET_NAME=cs361-v2-dev-data-example
# Lifetime of presigned upload/download URLs (60-3600 seconds)
S3_PRESIGN_EXPIRES_SECONDS=900
# Profile image: 5 MB, JPEG / PNG / WebP
PROFILE_IMAGE_MAX_BYTES=5242880
PROFILE_IMAGE_ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp"]
# CV: 10 MB, PDF
CV_MAX_BYTES=10485760
CV_ALLOWED_MIME_TYPES=["application/pdf"]
# Workload evidence files: 20 MB, PDF / JPEG / PNG
EVIDENCE_MAX_BYTES=20971520
EVIDENCE_ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png"]

# --- Auth (docs/v2/permissions.md) ------------------------------------------
# Cognito (infra/v2/cognito.yaml outputs). When set, `Authorization: Bearer <ID token>`
# is verified and the caller is the lecturer whose cognito_sub is the token's sub.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# The pool's JWKS JSON, for servers without internet access (empty = fetch it)
COGNITO_JWKS_JSON=
# Dev / tests / scripts: X-Lecturer-Id (act as a lecturer) and X-Dev-Roles (e.g.
# staff,admin) stand in for a token. Ignored when ENVIRONMENT=prod.
DEV_AUTH_HEADER_ENABLED=true
