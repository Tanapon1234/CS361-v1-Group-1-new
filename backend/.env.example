# -----------------------------------------------------------------------------
# CS361 Backend (FastAPI)
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real passwords; the real ones live in
# AWS Secrets Manager (see docs/v2/deployment-env.md and docs/v2/security.md).
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_NAME=CS361 Faculty Output API
# local | dev | demo | prod   (/docs and /openapi.json are disabled in prod)
ENVIRONMENT=local
LOG_LEVEL=INFO
# JSON list of allowed browser origins (Next.js frontend runs on :3000)
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Database (PostgreSQL / Aurora PostgreSQL) -------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cs361v2
DB_USER=postgres
# Must be changed outside ENVIRONMENT=local, or the app refuses to start.
DB_PASSWORD=change-me
# disable | prefer | require | verify-full   (use `require` or stricter for Aurora)
DB_SSLMODE=prefer
# true = log every SQL statement (local debugging only)
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- Object storage (S3) for profile images and CVs --------------------------
AWS_REGION=ap-southeast-1
DATA_BUCKET_NAME=cs361-v2-dev-data-example
# Lifetime of presigned upload/download URLs (60-3600 seconds)
S3_PRESIGN_EXPIRES_SECONDS=900
# 5 MB
PROFILE_IMAGE_MAX_BYTES=5242880
# 10 MB
CV_MAX_BYTES=10485760
# Workload evidence files: 20 MB, PDF / JPEG / PNG
EVIDENCE_MAX_BYTES=20971520
EVIDENCE_ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png"]

# --- Auth --------------------------------------------------------------------
# Cognito is not wired yet. While true, the caller is read from the X-Lecturer-Id
# header (a lecturer_id). Ignored when ENVIRONMENT=prod.
DEV_AUTH_HEADER_ENABLED=true
