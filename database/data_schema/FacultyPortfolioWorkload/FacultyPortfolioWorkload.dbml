// =====================================================================
// Faculty Portfolio & Workload — merged schema
// รวม Academic_Portfolio (ผลงานอาจารย์) + SemesterReport (ภาระงานอาจารย์)
// เชื่อมด้วยตารางเดียวกัน: lecturer (PK = lecturer_id)
//
// Target: PostgreSQL 15+ | Auth: AWS Cognito | Files: S3
//
// เป็น design แยกไว้ต่างหาก (ยังไม่ทับไฟล์เดิม) รอทีมรีวิวก่อนย้ายไปเป็น
// migration จริงใน database/migrations/ และ sync เข้า backend/app/v2/models
// =====================================================================

Project faculty_portfolio_workload {
  database_type: 'PostgreSQL'
  Note: 'รวมผลงานวิชาการ (Academic_Portfolio) กับภาระงานประจำภาค (SemesterReport) ไว้ที่ lecturer เดียวกัน'
}

// =====================================================================
// Enums — ทั้งหมดมาจาก SemesterReport (Academic_Portfolio เดิมไม่มี enum)
// =====================================================================

// ใช้กับ submission.rank_snapshot เท่านั้น — lecturer.rank ยังเป็น varchar อิสระเหมือนเดิม ไม่บังคับ enum เพื่อไม่กระทบของเดิม
Enum academic_rank {
  lecturer   [note: 'อาจารย์']
  asst_prof  [note: 'ผู้ช่วยศาสตราจารย์']
  assoc_prof [note: 'รองศาสตราจารย์']
  prof       [note: 'ศาสตราจารย์']
}

Enum position_code {
  dean            [note: 'คณบดี']
  vice_dean       [note: 'รองคณบดี']
  asst_dean       [note: 'ผู้ช่วยคณบดี']
  exec_committee  [note: 'กรรมการบริหารคณะ - ผู้ประเมินข้อ 3.1']
  dept_chair      [note: 'หัวหน้าสาขาวิชา - ผู้ประเมินข้อ 3.2']
  dept_deputy     [note: 'ผู้ช่วย/รองหัวหน้าสาขา']
  dept_secretary  [note: 'เลขา/ผู้ช่วยเลขาสาขา']
  dept_committee  [note: 'กรรมการประจำสาขาวิชา']
}

Enum submission_status {
  draft
  submitted
  assessing
  dept_review
  returned
  dept_approved
  sent_to_faculty
}

Enum signer_role {
  performer
  receiver
  dept_chair
  dept_committee
}

Enum approval_decision {
  approved
  returned
}

Enum weight_mode {
  fixed  [note: 'น้ำหนักตายตัว เช่น 0.075']
  ranged [note: 'ผู้ประเมินเป็นคนให้ เช่น หัวหน้าสาขา 1.0-2.0, กรรมการสาขา 50-100']
}

Enum range_basis {
  weight [note: 'ค่าที่ให้คือน้ำหนัก เอาไปคูณ 200 ต่อ']
  points [note: 'ค่าที่ให้คือคะแนนตรง ๆ']
}

Enum assessment_agg {
  none
  single
  average
}

Enum quantity_unit {
  credit
  topic
  course
  hour
  person
  term
}

Enum data_source {
  manual
  registrar
  registrar_edited
}

Enum evidence_status {
  pending
  uploaded
}

// =====================================================================
// 0) Master ที่ทั้งสองระบบใช้ร่วมกัน
// =====================================================================

Table department {
  id        smallint     [pk, increment]
  code      varchar(10)  [not null, unique]
  name_th   varchar(150) [not null]
  is_active boolean      [not null, default: true]

  Note: 'สาขาวิชา - ยกมาจาก SemesterReport ให้เป็น master กลาง (lecturer ก็ผูกกับตัวนี้)'
}

Table lecturer {
  lecturer_id uuid [pk, default: `gen_random_uuid()`]

  cognito_sub   varchar(64)   [unique, note: 'sub จาก Cognito — NULL ได้ชั่วคราวสำหรับอาจารย์ที่ยังไม่ผูก auth (ของเดิมไม่มีคอลัมน์นี้)']
  department_id smallint      [ref: > department.id, note: 'NULL ได้ชั่วคราวจนข้อมูลสาขาของอาจารย์เดิมพร้อม ค่อยบังคับ NOT NULL']

  name_th varchar(255) [not null]
  name_en varchar(255)

  rank varchar(100) [note: 'ข้อความอิสระเหมือนเดิม — ไม่แปลงเป็น academic_rank enum เพื่อไม่กระทบ model/DTO เดิม']

  profile_image_url text

  office varchar(255)
  phone varchar(50)
  phone_extension varchar(50)
  email varchar(255) [not null, unique]

  cv_url text

  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  is_active boolean [not null, default: true]

  Note: '''
  ตารางเดียวที่เชื่อม Academic_Portfolio กับ SemesterReport
  PK ชื่อ lecturer_id (ตามของเดิมที่ backend ใช้อยู่แล้ว ไม่ใช่ id แบบที่ SemesterReport ออกแบบไว้ตอนแรก)
  '''
}

// =====================================================================
// 1) Academic Portfolio — ผลงานวิชาการ (เหมือนของเดิมทุกคอลัมน์)
// =====================================================================

Table education {
  education_id smallint [pk, increment]

  lecturer_id uuid [not null]

  degree varchar(100)
  field varchar(255)
  institution varchar(500)
  country varchar(100)
  graduation_year varchar(10)
}

Table research_interest {
  research_interest_id smallint [pk, increment]

  name varchar(255) [not null, unique]
}

Table faculty_research_interest {
  lecturer_id uuid [not null]
  research_interest_id smallint [not null]

  indexes {
    (lecturer_id, research_interest_id) [pk]
  }
}

Table expertise {
  expertise_id smallint [pk, increment]

  description text [not null]
}

Table faculty_expertise {
  lecturer_id uuid [not null]
  expertise_id smallint [not null]

  indexes {
    (lecturer_id, expertise_id) [pk]
  }
}

Table publication {
  publication_id int [pk, increment]

  title text [not null]
  publication_year smallint

  venue text
  volume varchar(50)
  pages varchar(50)

  doi varchar(255) [unique]

  citation_text text

  created_at timestamptz [default: `now()`]
}

Table faculty_publication {
  lecturer_id uuid [not null]
  publication_id int [not null]

  author_order smallint

  indexes {
    (lecturer_id, publication_id) [pk]
  }
}

Table publication_profile {
  publication_profile_id smallint [pk, increment]

  lecturer_id uuid [not null]

  provider varchar(100) [not null]
  url text [not null]

  indexes {
    (lecturer_id, provider, url) [unique]
  }
}

// =====================================================================
// 2) ตำแหน่งบริหาร (จาก SemesterReport)
// =====================================================================

Table member_position {
  id            uuid          [pk, default: `gen_random_uuid()`]
  lecturer_id   uuid          [not null, ref: > lecturer.lecturer_id]
  position      position_code [not null]
  department_id smallint      [ref: > department.id, note: 'NULL = ตำแหน่งระดับคณะ (คณบดี/กรรมการบริหาร)']
  start_date    date          [not null]
  end_date      date          [note: 'NULL = ยังดำรงตำแหน่งอยู่']

  indexes {
    (lecturer_id, start_date)
    (position, department_id)
  }

  Note: 'เป็นทั้ง role ผู้ประเมิน และข้อมูลคะแนนข้อ 3.1/3.2 ของฟอร์มภาระงาน'
}

// =====================================================================
// 3) เกณฑ์ภาระงาน (versioned) — ไม่แตะ lecturer เลย เหมือนเดิมทั้งหมด
// =====================================================================

Table rubric_version {
  id                   smallint     [pk, increment]
  code                 varchar(30)  [not null, unique]
  approved_meeting     varchar(50)
  approved_on          date
  base_points          numeric(6,2) [not null, default: 200]
  overall_cap          numeric(8,2) [not null, default: 2000]
  min_required         numeric(8,2) [not null, default: 650]
  min_teaching_credits numeric(5,2) [not null, default: 6]
  is_active            boolean      [not null, default: true]
}

Table rubric_category {
  id         smallint     [pk, increment]
  version_id smallint     [not null, ref: > rubric_version.id]
  code       varchar(5)   [not null]
  name_th    varchar(100) [not null]
  cap        numeric(8,2) [not null]
  sort_order smallint     [not null]

  indexes { (version_id, code) [unique] }
}

Table rubric_section {
  id          smallint     [pk, increment]
  category_id smallint     [not null, ref: > rubric_category.id]
  parent_id   smallint     [ref: > rubric_section.id]
  code        varchar(10)  [not null]
  name_th     varchar(255) [not null]
  cap         numeric(8,2)
  max_entries smallint
  sort_order  smallint     [not null]

  indexes { (category_id, code) [unique] }
}

Table rubric_item {
  id                     smallint       [pk, increment]
  section_id             smallint       [not null, ref: > rubric_section.id]
  label_th               varchar(255)   [not null]
  weight_mode            weight_mode    [not null, default: 'fixed']
  weight                 numeric(6,4)
  weight_min             numeric(8,4)
  weight_max             numeric(8,4)
  range_basis            range_basis
  assessor_position      position_code
  assessment_agg         assessment_agg [not null, default: 'none']
  unit                   quantity_unit  [not null]
  unit_divisor           numeric(6,2)   [not null, default: 1]
  uses_participation     boolean        [not null, default: false]
  counts_teaching_credit boolean        [not null, default: false]
  once_per_round         boolean        [not null, default: false]
  tier_min               integer
  tier_max               integer
  field_schema           jsonb
  is_active              boolean        [not null, default: true]
}

// =====================================================================
// 4) รอบประเมิน + ใบกรอก
// =====================================================================

Table evaluation_round {
  id                  smallint     [pk, increment]
  rubric_version_id   smallint     [not null, ref: > rubric_version.id]
  name_th             varchar(100) [not null]
  period_start        date         [not null]
  period_end          date         [not null]
  salary_effective_on date         [not null]
  academic_year       smallint     [not null]
  semester            smallint
  submit_due_at       timestamptz
  is_open             boolean      [not null, default: false]
}

Table submission {
  id                  uuid              [pk, default: `gen_random_uuid()`]
  round_id            smallint          [not null, ref: > evaluation_round.id]
  lecturer_id         uuid              [not null, ref: > lecturer.lecturer_id]
  status              submission_status [not null, default: 'draft']
  rank_snapshot       academic_rank     [not null, note: 'map จาก lecturer.rank (varchar) เป็น enum ตอน submit']
  department_snapshot smallint          [not null, ref: > department.id]
  teaching_credits    numeric(6,2)      [not null, default: 0]
  raw_total           numeric(8,2)      [not null, default: 0]
  capped_total        numeric(8,2)      [not null, default: 0]
  submitted_at        timestamptz
  created_at          timestamptz       [not null, default: `now()`]
  updated_at          timestamptz       [not null, default: `now()`]

  indexes {
    (round_id, lecturer_id) [unique]
    (round_id, status)
  }
}

Table submission_entry {
  id                uuid         [pk, default: `gen_random_uuid()`]
  submission_id     uuid         [not null, ref: > submission.id, note: 'ON DELETE CASCADE']
  item_id           smallint     [not null, ref: > rubric_item.id]
  title             varchar(500)
  course_code       varchar(15)
  section_no        varchar(10)
  student_count     integer
  data_source       data_source  [not null, default: 'manual']
  synced_at         timestamptz
  quantity          numeric(8,2) [not null, default: 1]
  participation_pct numeric(5,2) [not null, default: 100]
  weight_applied    numeric(8,4)
  credits           numeric(5,2)
  score             numeric(8,2) [not null, default: 0]
  details           jsonb
  note              text
  sort_order        smallint     [not null, default: 0]
  created_at        timestamptz  [not null, default: `now()`]
  updated_at        timestamptz  [not null, default: `now()`]

  indexes {
    (submission_id, item_id)
    (course_code, section_no)
  }
}

Table entry_assessment {
  id            uuid          [pk, default: `gen_random_uuid()`]
  entry_id      uuid          [not null, ref: > submission_entry.id, note: 'ON DELETE CASCADE']
  assessor_id   uuid          [not null, ref: > lecturer.lecturer_id]
  position_used position_code [not null]
  value_given   numeric(8,4)  [not null]
  comment       text
  assessed_at   timestamptz   [not null, default: `now()`]

  indexes {
    (entry_id, assessor_id) [unique]
  }
}

Table entry_evidence {
  id          uuid            [pk, default: `gen_random_uuid()`]
  entry_id    uuid            [not null, ref: > submission_entry.id, note: 'ON DELETE CASCADE']
  ref_code    varchar(50)
  label       varchar(255)
  s3_key      varchar(512)    [not null, unique]
  file_name   varchar(255)    [not null]
  mime_type   varchar(100)    [not null]
  size_bytes  bigint          [not null]
  checksum    char(64)
  status      evidence_status [not null, default: 'pending']
  uploaded_by uuid            [not null, ref: > lecturer.lecturer_id]
  created_at  timestamptz     [not null, default: `now()`]

  indexes {
    (entry_id)
    (status)
  }
}

// =====================================================================
// 5) สรุป + การลงนาม
// =====================================================================

Table submission_category_total {
  submission_id uuid         [ref: > submission.id]
  category_id   smallint     [ref: > rubric_category.id]
  raw_score     numeric(8,2) [not null]
  capped_score  numeric(8,2) [not null]

  indexes { (submission_id, category_id) [pk] }
}

Table submission_approval {
  id            uuid              [pk, default: `gen_random_uuid()`]
  submission_id uuid              [not null, ref: > submission.id]
  signer_id     uuid              [not null, ref: > lecturer.lecturer_id]
  role          signer_role       [not null]
  decision      approval_decision [not null]
  comment       text
  signed_at     timestamptz       [not null, default: `now()`]

  indexes { (submission_id, signed_at) }
}

// =====================================================================
// Relationships ของฝั่ง Academic Portfolio (เหมือนของเดิม)
// =====================================================================

Ref: education.lecturer_id > lecturer.lecturer_id [delete: cascade]

Ref: faculty_research_interest.lecturer_id > lecturer.lecturer_id [delete: cascade]
Ref: faculty_research_interest.research_interest_id > research_interest.research_interest_id [delete: cascade]

Ref: faculty_expertise.lecturer_id > lecturer.lecturer_id [delete: cascade]
Ref: faculty_expertise.expertise_id > expertise.expertise_id [delete: cascade]

Ref: faculty_publication.lecturer_id > lecturer.lecturer_id [delete: cascade]
Ref: faculty_publication.publication_id > publication.publication_id [delete: cascade]

Ref: publication_profile.lecturer_id > lecturer.lecturer_id [delete: cascade]

// =====================================================================
// DDL เสริมที่ dbdiagram วาดไม่ได้ ใส่ตอนเขียน migration จริง
// =====================================================================
// CHECK participation_pct > 0 AND participation_pct <= 100
// CHECK quantity > 0 AND score >= 0
// CHECK student_count IS NULL OR student_count >= 0
// CHECK (weight_mode='fixed'  AND weight IS NOT NULL)
//    OR (weight_mode='ranged' AND weight_min IS NOT NULL AND weight_min <= weight_max)
// CHECK end_date IS NULL OR end_date > start_date       -- member_position
// CHECK period_end > period_start                       -- evaluation_round
//
// CREATE INDEX CONCURRENTLY idx_entry_details ON submission_entry USING GIN (details);
// CREATE INDEX CONCURRENTLY idx_position_active ON member_position (department_id, position)
//   WHERE end_date IS NULL;
// CREATE INDEX CONCURRENTLY idx_submission_draft ON submission (lecturer_id)
//   WHERE status = 'draft';
//
// TRIGGER: บล็อก INSERT/UPDATE/DELETE บน submission_entry เมื่อ submission.status <> 'draft'
// VIEW v_section_total: LEAST(SUM(score), section.cap) รายข้อย่อย
