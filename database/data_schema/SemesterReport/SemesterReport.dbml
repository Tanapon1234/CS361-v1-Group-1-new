// =====================================================================
// ระบบบันทึกภาระงานอาจารย์ (Faculty Workload Report)  v2
// Target: PostgreSQL 15+ | Auth: AWS Cognito | Files: S3
//
// สูตรคะแนนเดียวกันทุกหมวด:
//   score = weight * base_points(200) * (quantity / unit_divisor) * participation_pct
// =====================================================================

Project faculty_workload {
  database_type: 'PostgreSQL'
  Note: 'ระบบกรอกภาระงานอาจารย์เพื่อประเมินเลื่อนเงินเดือน'
}

Enum academic_rank {
  lecturer   [note: 'อาจารย์']
  asst_prof  [note: 'ผู้ช่วยศาสตราจารย์']
  assoc_prof [note: 'รองศาสตราจารย์']
  prof       [note: 'ศาสตราจารย์']
}

Enum position_code {
  dean            [note: 'คณบดี']
  vice_dean       [note: 'รองคณบดี']
  asst_dean       [note: 'ผู้ช่วยคณบดี']
  exec_committee  [note: 'กรรมการบริหารคณะ - ผู้ประเมินข้อ 3.1']
  dept_chair      [note: 'หัวหน้าสาขาวิชา - ผู้ประเมินข้อ 3.2']
  dept_deputy     [note: 'ผู้ช่วย/รองหัวหน้าสาขา']
  dept_secretary  [note: 'เลขา/ผู้ช่วยเลขาสาขา']
  dept_committee  [note: 'กรรมการประจำสาขาวิชา']
}

Enum submission_status {
  draft           [note: 'อาจารย์กำลังกรอก - แก้ไขได้']
  submitted       [note: 'ส่งแล้ว - ล็อกการแก้ไข']
  assessing       [note: 'รอผู้ประเมินให้คะแนนหมวด 3']
  dept_review     [note: 'กรรมการสาขากำลังตรวจ']
  returned        [note: 'ตีกลับให้แก้']
  dept_approved   [note: 'สาขาอนุมัติ']
  sent_to_faculty [note: 'ส่งคณะแล้ว']
}

Enum signer_role {
  performer      [note: 'ผู้ปฏิบัติงาน']
  receiver       [note: 'ผู้รับฟอร์ม']
  dept_chair     [note: 'ประธานกรรมการระดับสาขาวิชา']
  dept_committee [note: 'กรรมการระดับสาขาวิชา']
}

Enum approval_decision {
  approved
  returned
}

Enum weight_mode {
  fixed  [note: 'น้ำหนักตายตัว เช่น 0.075']
  ranged [note: 'ผู้ประเมินเป็นคนให้ เช่น หัวหน้าสาขา 1.0-2.0, กรรมการสาขา 50-100']
}

Enum range_basis {
  weight [note: 'ค่าที่ให้คือน้ำหนัก เอาไปคูณ 200 ต่อ เช่น ข้อ 3.1 (1.0-2.0)']
  points [note: 'ค่าที่ให้คือคะแนนตรง ๆ เช่น ข้อ 3.2 (50-100), (0-25)']
}

Enum assessment_agg {
  none    [note: 'ไม่ต้องประเมิน']
  single  [note: 'ผู้ประเมินคนเดียว เช่น หัวหน้าสาขา']
  average [note: 'เฉลี่ยจากผู้ประเมินหลายคน เช่น กรรมการบริหาร']
}

Enum quantity_unit {
  credit [note: 'หน่วยกิต - ข้อ 1.1, 1.9, 1.11']
  topic  [note: 'เรื่อง/ชิ้นงาน - ข้อ 1.4, 1.5, 2.x, 4.x']
  course [note: 'วิชา - ข้อ 3.3, 3.4']
  hour   [note: 'ชั่วโมง - ปฏิบัติการ']
  person [note: 'คน - ข้อ 4.5']
  term   [note: 'ต่อภาคการศึกษา - ข้อ 3.1, 3.2']
}

Enum data_source {
  manual           [note: 'อาจารย์กรอกเอง (ตอนนี้)']
  registrar        [note: 'ดึงจาก API ทะเบียน (อนาคต)']
  registrar_edited [note: 'ดึงมาแล้วอาจารย์แก้ทับ - ต้องให้กรรมการตรวจ']
}

Enum evidence_status {
  pending  [note: 'ออก presigned URL แล้ว รออัปโหลดจริง']
  uploaded [note: 'ไฟล์อยู่ใน S3 แล้ว']
}

// =====================================================================
// 1) ผู้ใช้ และ ตำแหน่ง
// =====================================================================

Table department {
  id        smallint     [pk, increment]
  code      varchar(10)  [not null, unique]
  name_th   varchar(150) [not null]
  is_active boolean      [not null, default: true]

  Note: 'สาขาวิชา - สิทธิ์ผู้ประเมินและรายงานสรุปผูกกับสาขา'
}

Table lecturer{
  id            uuid          [pk, default: `gen_random_uuid()`]
  cognito_sub   varchar(64)   [not null, unique, note: 'sub จาก Cognito = จุดเชื่อมกับ auth']
  name_th varchar(255) [not null]
  name_en varchar(255)
  email         varchar(255)  [not null, unique]
  department_id smallint      [not null, ref: > department.id]
  rank          academic_rank [not null]
  profile_image_url text

  office varchar(255)
  phone varchar(50)
  phone_extension varchar(50)
  cv_url text
  is_active     boolean       [not null, default: true]
  created_at    timestamptz   [not null, default: `now()`]
  updated_at    timestamptz   [not null, default: `now()`]

  Note: '''
  เงาของ Cognito - ไม่เก็บ password/MFA
  Cognito group คุม role กว้าง ๆ (faculty / staff / student)
  ส่วนใครมีสิทธิ์ประเมินใคร อยู่ที่ member_position เพราะผูกกับสาขาและช่วงเวลา
  '''
}

Table member_position {
  id            uuid          [pk, default: `gen_random_uuid()`]
  lecturer_id     uuid          [not null, ref: > lecturer.id]
  position      position_code [not null]
  department_id smallint      [ref: > department.id, note: 'NULL = ตำแหน่งระดับคณะ (คณบดี/กรรมการบริหาร)']
  start_date    date          [not null, note: 'ช่องวันที่ดำรงตำแหน่ง ในฟอร์มข้อ 3.1/3.2']
  end_date      date          [note: 'NULL = ยังดำรงตำแหน่งอยู่']

  indexes {
    (lecturer_id, start_date)
    (position, department_id)
  }

  Note: '''
  ตารางนี้ทำงาน 2 อย่างพร้อมกัน จึงคุ้มที่จะมี:
  1. เป็น role ผู้ประเมิน - ระบบรู้ว่าใครประเมินหมวด 3 ของใครได้ในรอบนั้น
     (Cognito group ทำแทนไม่ได้ เพราะสิทธิ์ขึ้นกับสาขา + ช่วงวันที่ + เปลี่ยนทุกวาระ)
  2. เป็นข้อมูลคะแนนข้อ 3.1/3.2 เอง - ฟอร์มต้องการวันที่ดำรงตำแหน่งเพื่อคิดตามสัดส่วน
  '''
}

// =====================================================================
// 2) เกณฑ์ภาระงาน (versioned)
// =====================================================================

Table rubric_version {
  id                   smallint     [pk, increment]
  code                 varchar(30)  [not null, unique, note: 'เช่น 2567-r1']
  approved_meeting     varchar(50)  [note: 'เช่น 6/2567']
  approved_on          date
  base_points          numeric(6,2) [not null, default: 200]
  overall_cap          numeric(8,2) [not null, default: 2000]
  min_required         numeric(8,2) [not null, default: 650]
  min_teaching_credits numeric(5,2) [not null, default: 6]
  is_active            boolean      [not null, default: true]

  Note: 'เกณฑ์ผ่านมติประชุมและแก้ทุกปี - ถ้าแก้ทับของเดิม คะแนนที่เซ็นอนุมัติไปแล้วจะคำนวณใหม่ไม่ตรง'
}

Table rubric_category {
  id         smallint     [pk, increment]
  version_id smallint     [not null, ref: > rubric_version.id]
  code       varchar(5)   [not null, note: '1-5']
  name_th    varchar(100) [not null]
  cap        numeric(8,2) [not null, note: '900/900/400/300/100']
  sort_order smallint     [not null]

  indexes { (version_id, code) [unique] }
}

Table rubric_section {
  id          smallint     [pk, increment]
  category_id smallint     [not null, ref: > rubric_category.id]
  parent_id   smallint     [ref: > rubric_section.id, note: 'self-FK รองรับ 2.3 -> 2.3.1..2.3.5']
  code        varchar(10)  [not null]
  name_th     varchar(255) [not null]
  cap         numeric(8,2) [note: '1.3=120, 1.4=200, 3.3=75, 4.4=100']
  max_entries smallint     [note: '4.1.1 ไม่เกิน 20 คำสั่ง, 4.2.1 ไม่เกิน 10']
  sort_order  smallint     [not null]

  indexes { (category_id, code) [unique] }
}

Table rubric_item {
  id                     smallint       [pk, increment]
  section_id             smallint       [not null, ref: > rubric_section.id]
  label_th               varchar(255)   [not null]
  weight_mode            weight_mode    [not null, default: 'fixed']
  weight                 numeric(6,4)   [note: 'ใช้เมื่อ fixed']
  weight_min             numeric(8,4)   [note: 'ใช้เมื่อ ranged']
  weight_max             numeric(8,4)
  range_basis            range_basis    [note: 'ค่าที่ผู้ประเมินให้ เป็นน้ำหนักหรือคะแนนตรง ๆ']
  assessor_position      position_code  [note: 'ใครมีสิทธิ์ประเมินข้อนี้ - join กับ member_position']
  assessment_agg         assessment_agg [not null, default: 'none']
  unit                   quantity_unit  [not null]
  unit_divisor           numeric(6,2)   [not null, default: 1, note: 'บรรยาย ป.ตรี = 3']
  uses_participation     boolean        [not null, default: false]
  counts_teaching_credit boolean        [not null, default: false]
  once_per_round         boolean        [not null, default: false, note: '2.9 เลือกได้ 1 ข้อ']
  tier_min               integer        [note: 'ช่วงจำนวน นศ. ที่ใช้ item นี้ เช่น <100 = 1.0']
  tier_max               integer        [note: 'พอ API ทะเบียนมา ระบบเลือก item ให้อัตโนมัติจากจำนวน นศ.']
  field_schema           jsonb          [note: 'ฟิลด์เสริมของข้อนั้น เช่น quartile, budget']
  is_active              boolean        [not null, default: true]

  Note: 'หนึ่งแถว = หนึ่งตัวเลือกในช่องชนิดงาน/หน้าที่ ของฟอร์ม'
}

// =====================================================================
// 3) รอบประเมิน + ใบกรอก
// =====================================================================

Table evaluation_round {
  id                  smallint     [pk, increment]
  rubric_version_id   smallint     [not null, ref: > rubric_version.id]
  name_th             varchar(100) [not null]
  period_start        date         [not null]
  period_end          date         [not null]
  salary_effective_on date         [not null, note: 'วันเลื่อนเงินเดือน']
  academic_year       smallint     [not null]
  semester            smallint
  submit_due_at       timestamptz
  is_open             boolean      [not null, default: false]
}

Table submission {
  id                  uuid              [pk, default: `gen_random_uuid()`]
  round_id            smallint          [not null, ref: > evaluation_round.id]
  lecturer_id           uuid              [not null, ref: > lecturer.id]
  status              submission_status [not null, default: 'draft']
  rank_snapshot       academic_rank     [not null]
  department_snapshot smallint          [not null, ref: > department.id]
  teaching_credits    numeric(6,2)      [not null, default: 0, note: 'ต้องไม่ต่ำกว่า 6']
  raw_total           numeric(8,2)      [not null, default: 0]
  capped_total        numeric(8,2)      [not null, default: 0]
  submitted_at        timestamptz
  created_at          timestamptz       [not null, default: `now()`]
  updated_at          timestamptz       [not null, default: `now()`]

  indexes {
    (round_id, lecturer_id) [unique]
    (round_id, status)
  }
}

Table submission_entry {
  id                uuid         [pk, default: `gen_random_uuid()`]
  submission_id     uuid         [not null, ref: > submission.id, note: 'ON DELETE CASCADE']
  item_id           smallint     [not null, ref: > rubric_item.id]
  title             varchar(500) [note: 'ชื่อเรื่อง/โครงการ/ผลงาน/ชื่อนักศึกษา']
  course_code       varchar(15)  [note: 'text เฉย ๆ - ระบบนี้ไม่ใช่เจ้าของข้อมูลรายวิชา']
  section_no        varchar(10)  [note: 'sec - ใช้ตอน sync กับทะเบียน']
  student_count     integer      [note: 'ยกเป็นคอลัมน์เพราะเป็นตัวกำหนดน้ำหนัก 1.0-1.3 ต้อง query/ตรวจได้']
  data_source       data_source  [not null, default: 'manual', note: 'บอกว่าตัวเลขมาจากมือหรือ API']
  synced_at         timestamptz  [note: 'ครั้งล่าสุดที่ดึงจากทะเบียน']
  quantity          numeric(8,2) [not null, default: 1]
  participation_pct numeric(5,2) [not null, default: 100]
  weight_applied    numeric(8,4) [note: 'snapshot น้ำหนักที่ใช้จริง - NULL ระหว่างรอผู้ประเมินให้ค่า']
  credits           numeric(5,2)
  score             numeric(8,2) [not null, default: 0]
  details           jsonb        [note: 'ฟิลด์ที่ใช้ไม่กี่ข้อ เช่น hours, quartile, budget']
  note              text
  sort_order        smallint     [not null, default: 0]
  created_at        timestamptz  [not null, default: `now()`]
  updated_at        timestamptz  [not null, default: `now()`]

  indexes {
    (submission_id, item_id)
    (course_code, section_no)
  }

  Note: 'ตารางเดียวแทนข้อย่อย 1.1-4.6 ทั้งหมด - ลบได้เฉพาะตอน draft จึงไม่ต้อง soft delete'
}

Table entry_assessment {
  id            uuid          [pk, default: `gen_random_uuid()`]
  entry_id      uuid          [not null, ref: > submission_entry.id, note: 'ON DELETE CASCADE']
  assessor_id   uuid          [not null, ref: > lecturer.id]
  position_used position_code [not null, note: 'snapshot ตำแหน่งที่ใช้สิทธิ์ประเมิน - วาระหมดแล้วยังตรวจย้อนหลังได้']
  value_given   numeric(8,4)  [not null, note: 'ต้องอยู่ในช่วง weight_min..weight_max ของ item']
  comment       text
  assessed_at   timestamptz   [not null, default: `now()`]

  indexes {
    (entry_id, assessor_id) [unique, note: 'ผู้ประเมิน 1 คน ให้ค่าได้ครั้งเดียวต่อรายการ']
  }

  Note: '''
  แยกจาก submission_entry เพราะ:
  1. ข้อ 3.1 ประเมินโดยกรรมการบริหารหลายคน ต้องเก็บรายคนแล้วค่อยเฉลี่ย
  2. อาจารย์เจ้าของฟอร์มต้องแก้ค่านี้ไม่ได้ - แยกตารางแล้วตัดสิทธิ์ที่ระดับ API ได้ตรง ๆ
  3. เก็บได้ว่าใครให้เท่าไรเมื่อไร ใช้ตอนมีข้อโต้แย้ง
  '''
}

Table entry_evidence {
  id          uuid            [pk, default: `gen_random_uuid()`]
  entry_id    uuid            [not null, ref: > submission_entry.id, note: 'ON DELETE CASCADE']
  ref_code    varchar(50)     [note: 'เช่น RG301-2025-000076 (wolf) หรือเลขคำสั่ง']
  label       varchar(255)    [note: 'เช่น คำสั่งแต่งตั้ง / ใบรับรองสัดส่วน / Quartile Scimago']
  s3_key      varchar(512)    [not null, unique]
  file_name   varchar(255)    [not null, note: 'ชื่อไฟล์เดิมของผู้ใช้ ใช้ตอนให้ดาวน์โหลด']
  mime_type   varchar(100)    [not null]
  size_bytes  bigint          [not null]
  checksum    char(64)        [note: 'SHA-256 - กันไฟล์ซ้ำและยืนยันว่าไฟล์ไม่ถูกเปลี่ยนหลังอนุมัติ']
  status      evidence_status [not null, default: 'pending']
  uploaded_by uuid            [not null, ref: > lecturer.id]
  created_at  timestamptz     [not null, default: `now()`]

  indexes {
    (entry_id)
    (status) [note: 'ใช้กวาดแถว pending ค้างเกิน 24 ชม. ทิ้ง']
  }

  Note: '''
  ไม่เก็บ bucket/region ในตาราง - เป็น config ของ deployment ไม่ใช่ข้อมูล
  status=pending จำเป็นเพราะ flow presigned URL ต้องสร้างแถวก่อนไฟล์ขึ้นจริง
  '''
}

// =====================================================================
// 4) สรุป + การลงนาม
// =====================================================================

Table submission_category_total {
  submission_id uuid         [ref: > submission.id]
  category_id   smallint     [ref: > rubric_category.id]
  raw_score     numeric(8,2) [not null]
  capped_score  numeric(8,2) [not null]

  indexes { (submission_id, category_id) [pk] }

  Note: 'ตารางสรุปรวมคะแนน 5 หมวดหน้าแรก - freeze ตอนส่ง ไม่ให้ผลที่เซ็นแล้วเปลี่ยนตาม rubric'
}

Table submission_approval {
  id            uuid              [pk, default: `gen_random_uuid()`]
  submission_id uuid              [not null, ref: > submission.id]
  signer_id     uuid              [not null, ref: > lecturer.id]
  role          signer_role       [not null]
  decision      approval_decision [not null]
  comment       text
  signed_at     timestamptz       [not null, default: `now()`]

  indexes { (submission_id, signed_at) }

  Note: 'แทนช่องลงนามท้ายฟอร์ม (ผู้ปฏิบัติงาน/ผู้รับฟอร์ม/ประธาน+กรรมการสาขา)'
}

// =====================================================================
// DDL เสริมที่ dbdiagram วาดไม่ได้ ใส่ตอนเขียน migration จริง
// =====================================================================
// CHECK participation_pct > 0 AND participation_pct <= 100
// CHECK quantity > 0 AND score >= 0
// CHECK student_count IS NULL OR student_count >= 0
// CHECK (weight_mode='fixed'  AND weight IS NOT NULL)
//    OR (weight_mode='ranged' AND weight_min IS NOT NULL AND weight_min <= weight_max)
// CHECK end_date IS NULL OR end_date > start_date       -- member_position
// CHECK period_end > period_start                       -- evaluation_round
//
// CREATE INDEX CONCURRENTLY idx_entry_details ON submission_entry USING GIN (details);
// CREATE INDEX CONCURRENTLY idx_position_active ON member_position (department_id, position)
//   WHERE end_date IS NULL;
// CREATE INDEX CONCURRENTLY idx_submission_draft ON submission (lecturer_id)
//   WHERE status = 'draft';
//
// TRIGGER: บล็อก INSERT/UPDATE/DELETE บน submission_entry เมื่อ submission.status <> 'draft'
// VIEW v_section_total: LEAST(SUM(score), section.cap) รายข้อย่อย
